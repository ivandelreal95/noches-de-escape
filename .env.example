# Desarrollo local. Copia a .env (ese archivo NO se sube a git).
# En internet (Render / Railway) define las mismas claves en el panel del host.
# NUNCA uses estos valores de ejemplo en producción.

# Panel /admin/entrar — en producción: secreto fuerte (NO uses posada-admin)
ADMIN_PASSWORD=posada-admin

# Firma de cookies de sesión — en producción: cadena larga y aleatoria
SESSION_SECRET=cambiar-en-produccion-fase1

# Puerto HTTP. Render y Railway lo asignan solos; la app respeta process.env.PORT
PORT=3001

# SQLite. En producción: ruta dentro del disco persistente, p. ej. /data/noches.db
DATABASE_PATH=./data/noches.db

# En el host público debe ser production (ya viene en render.yaml / Dockerfile)
# NODE_ENV=development

# Cookies Secure (HTTPS). En producción es true. Para probar npm start en http local: false
# COOKIE_SECURE=false
